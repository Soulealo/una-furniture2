# Cloudflare D1 is configured in wrangler.toml.
# For production, create a real database with:
# npx wrangler d1 create unafurniture
# Then replace database_id in wrangler.toml with the generated ID.

# Google OAuth credentials are Cloudflare Worker secrets, not frontend values.
# Set them with:
# npx wrangler secret put GOOGLE_CLIENT_ID
# npx wrangler secret put GOOGLE_CLIENT_SECRET
# npx wrangler secret put JWT_SECRET
